# Local setup metadata only. Copy to the target project root as .env.
# Never store tokens, passwords, client secrets, auth caches, or approvals.
# Empty values are unknown, not defaults or evidence of completed checks.
# Quote values containing spaces or #. Use single quotes for Windows paths.

# Required before repository initialization (reuse) or creation (create).
# Absolute target project path, e.g. 'C:\github\my-codeapp'
CODEAPPS_PROJECT_PATH=
GITHUB_OWNER=
GITHUB_REPO=
# private | public | internal (confirm organization/plan support)
GITHUB_VISIBILITY=
GITHUB_BRANCH=
# reuse | create (Template + Clone uses reuse; verify origin and GitHub identity)
# create requires an explicit request to create a new repository.
GITHUB_REPO_MODE=

# Required target identity. Display name does not replace environment ID.
POWER_PLATFORM_TENANT_ID=
POWER_PLATFORM_ENVIRONMENT_NAME=
POWER_PLATFORM_ENVIRONMENT_ID=

# Required: new | existing
CODEAPPS_APP_STATE=
CODEAPPS_APP_NAME=
# Required for an existing app; fill after first publish for a new app.
CODEAPPS_APP_ID=
# Required before first-publish support and access-sharing verification.
CODEAPPS_APP_OWNER=
CODEAPPS_INITIAL_PUBLISH_MAKER=

# Required: true | false. GUID is required only when using a solution.
CODEAPPS_USE_SOLUTION=
POWER_PLATFORM_SOLUTION_ID=

# GitHub Environment is distinct from the Power Platform environment.
GITHUB_ENVIRONMENT=
# Comma-separated GitHub logins or team slugs; verify actual protection.
GITHUB_ENVIRONMENT_REVIEWERS=
GITHUB_ENVIRONMENT_ADMIN=

# Required before authentication setup; no secret values belong here.
# Record the organization-approved method, then verify CLI support.
CODEAPPS_AUTH_METHOD=
CODEAPPS_CREDENTIAL_ADMIN=
# Conditional non-secret SP identifiers. Do not confuse these two IDs.
CODEAPPS_SP_CLIENT_ID=
CODEAPPS_SP_ENTERPRISE_APPLICATION_OBJECT_ID=
